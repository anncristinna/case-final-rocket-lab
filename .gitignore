# --- Dados do case (confidenciais, propriedade intelectual da Visagio) ---
# NUNCA versionar as bases, nem derivados em nível de chamado (ex.: o pacote CSV do Power BI).
# Tudo que é dado fica em data/ e fora do git; só o README.md de data/ é versionado.
data/*
!data/README.md
!data/raw/
data/raw/*
!data/raw/.gitkeep
*.csv
*.CSV
*.xlsx
*.parquet
*.zip
*.pbix
# Power BI (PBIP): cache e configuracao local nunca vao para o git (os .gitignore do projeto ja cobrem; aqui e a rede de seguranca)
**/.pbi/localSettings.json
**/.pbi/cache.abf
# Exceção: manifestos e comparação de idempotência (só nomes de tabela, contagens e checksums; sem dado pessoal)
!docs/tecnico/evidencias/**/*.csv

# --- Segredos ---
.env
.env.*
!.env.example
.mcp.json
databrickscfg
.databrickscfg

# --- Python / Jupyter ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- Databricks / IDE / SO ---
.databricks/
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Claude Code (configs pessoais) ---
.claude/settings.local.json

# --- PPTX de trabalho (só os PDFs finais são versionados) ---
docs/pdf/*.pptx
