	partition demanda_dia_hora = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\demanda_dia_hora.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"dia_semana", Int64.Type}, {"nome_dia", type text}, {"hora_abertura", Int64.Type}, {"faixa_horaria", type text}, {"chamados", Int64.Type}, {"pct_abandono", type number}, {"tme_min", type number}, {"p90_espera_min", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "hora_rotulo", each Text.From([hora_abertura]) & "h", type text)
				in
					Extra1

	annotation PBI_ResultType = Table

