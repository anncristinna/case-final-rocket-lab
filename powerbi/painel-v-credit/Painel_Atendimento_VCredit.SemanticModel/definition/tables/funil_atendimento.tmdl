	partition funil_atendimento = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\funil_atendimento.csv"), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"etapa_funil", type text}, {"canal", type text}, {"tipo_canal", type text}, {"chamados", Int64.Type}, {"pct_chamados", type number}, {"abandonados", Int64.Type}, {"pct_abandono", type number}, {"pct_resolucao", type number}, {"tme_min", type number}, {"tma_min", type number}, {"custo_total", type number}, {"pct_custo", type number}, {"custo_medio", type number}, {"custo_por_resolucao", type number}, {"csat_pct", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "canal_rotulo", each if [canal] = "URA" then "URA" else Text.Proper([canal]), type text)
				in
					Extra1

	annotation PBI_ResultType = Table

