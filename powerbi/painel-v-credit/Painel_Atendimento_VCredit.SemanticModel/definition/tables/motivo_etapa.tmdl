	partition motivo_etapa = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\motivo_etapa.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"categoria", type text}, {"motivo", type text}, {"etapa_funil", type text}, {"chamados", Int64.Type}, {"pct_do_motivo", type number}, {"pct_resolucao", type number}, {"tma_min", type number}, {"custo_medio", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "motivo_rotulo", each if Text.Contains([motivo], " (") then Text.BeforeDelimiter([motivo], " (") else [motivo], type text)
				in
					Extra1

	annotation PBI_ResultType = Table

