	partition simulacao_ganhos = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\simulacao_ganhos.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"cenario", type text}, {"item", type text}, {"chamados_base", Int64.Type}, {"premissa_pct", type number}, {"chamados_evitados", type number}, {"ganho_unitario", type number}, {"economia_periodo", type number}, {"economia_mensal_media", type number}, {"economia_anualizada", type number}}, "en-US"),
					Filtrado = Table.SelectRows(Tipos, each [item] <> "** TOTAL **"),
					Extra1 = Table.AddColumn(Filtrado, "cenario_cod", each Text.Start([cenario], 1), type text),
					Extra2 = Table.AddColumn(Extra1, "item_rotulo", each if Text.Contains([item], " (") then Text.BeforeDelimiter([item], " (") else [item], type text),
					Extra3 = Table.AddColumn(Extra2, "iniciativa", each Text.Start([cenario], 1) & " · " & (if Text.Contains([item], " (") then Text.BeforeDelimiter([item], " (") else [item]), type text)
				in
					Extra3

	annotation PBI_ResultType = Table

