	partition motivos_pareto = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\motivos_pareto.csv"), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"motivo", type text}, {"categoria", type text}, {"criticidade", type text}, {"chamados", Int64.Type}, {"pct_chamados", type number}, {"pct_acumulado", type number}, {"pct_chegou_humano", type number}, {"pct_nivel2", type number}, {"pct_resolucao", type number}, {"pct_reincidencia", type number}, {"tma_min", type number}, {"custo_total", type number}, {"custo_medio", type number}, {"csat_pct", type number}, {"pct_custo", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "motivo_rotulo", each if Text.Contains([motivo], " (") then Text.BeforeDelimiter([motivo], " (") else [motivo], type text),
					Extra2 = Table.AddColumn(Extra1, "criticidade_rotulo", each Text.Proper([criticidade]), type text)
				in
					Extra2

	annotation PBI_ResultType = Table

