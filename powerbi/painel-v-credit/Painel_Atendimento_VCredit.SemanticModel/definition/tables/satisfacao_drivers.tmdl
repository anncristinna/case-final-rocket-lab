	partition satisfacao_drivers = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\satisfacao_drivers.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"dimensao", type text}, {"valor", type text}, {"respostas", type number}, {"csat_pct", type number}, {"nota_media", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "valor_rotulo", each if [dimensao] = "canal" then (if [valor] = "URA" then "URA" else Text.Proper([valor])) else [valor], type text)
				in
					Extra1

	annotation PBI_ResultType = Table

