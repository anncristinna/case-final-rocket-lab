	partition comparativo_yoy = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\comparativo_yoy.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"mes", Int64.Type}, {"nome_mes", type text}, {"chamados_2025", Int64.Type}, {"chamados_2026", Int64.Type}, {"csat_pct_2025", type number}, {"csat_pct_2026", type number}, {"pct_abandono_2025", type number}, {"pct_abandono_2026", type number}, {"pct_resolucao_2025", type number}, {"pct_resolucao_2026", type number}, {"tme_min_2025", type number}, {"tme_min_2026", type number}, {"custo_medio_2025", type number}, {"custo_medio_2026", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "nome_mes_curto", each Text.Start([nome_mes], 3), type text)
				in
					Extra1

	annotation PBI_ResultType = Table

