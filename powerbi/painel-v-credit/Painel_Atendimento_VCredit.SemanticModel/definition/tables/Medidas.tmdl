	measure 'Alerta 3 Texto' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([Abandono], DimMes[Data] = _ini)
			VAR _b = CALCULATE([Abandono], DimMes[Data] = _fim)
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			VAR _d = [Alerta 3 Delta]
			RETURN IF(ISBLANK(_d) || _d < 1, BLANK(), "A taxa de chamados sem início de atendimento (proxy de abandono) subiu " & FORMAT(_d, "0.0") & " p.p. entre " & _ri & " e " & _rf & " (" & FORMAT(_a, "0.0") & "% → " & FORMAT(_b, "0.0") & "%).")
