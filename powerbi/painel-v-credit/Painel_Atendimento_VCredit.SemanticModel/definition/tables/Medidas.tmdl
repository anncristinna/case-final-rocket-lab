	measure Evidência =
			VAR _op = SELECTEDVALUE(Oportunidades[Oportunidade])
			VAR _app = CALCULATE(SUM(motivos_pareto[chamados]), motivos_pareto[motivo] = "Problema com aplicativo")
			VAR _appp = CALCULATE(SUM(motivos_pareto[pct_chamados]), motivos_pareto[motivo] = "Problema com aplicativo")
			VAR _n2i = MIN(DimMes[Data])
			VAR _n2f = MAX(DimMes[Data])
			VAR _r0 = CALCULATE([Resolução Etapa], DimMes[Data] = _n2i, DimEtapa[Etapa] = "Nível 2")
			VAR _r1 = CALCULATE([Resolução Etapa], DimMes[Data] = _n2f, DimEtapa[Etapa] = "Nível 2")
			VAR _l0 = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _n2i)
			VAR _l1 = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _n2f)
			VAR _pk = TOPN(1, ADDCOLUMNS(SUMMARIZE(demanda_dia_hora, demanda_dia_hora[nome_dia], demanda_dia_hora[hora_abertura]), "c", [Chamados Hora], "a", [Abandono Hora]), [c], DESC)
			VAR _ho = CALCULATE(SUM(perfil_cliente[pct_da_dimensao]), perfil_cliente[dimensao] = "faixa_etaria", perfil_cliente[valor] = "65+", perfil_cliente[etapa_funil] <> "Autosserviço")
			VAR _hy = CALCULATE(SUM(perfil_cliente[pct_da_dimensao]), perfil_cliente[dimensao] = "faixa_etaria", perfil_cliente[valor] = "25-34", perfil_cliente[etapa_funil] <> "Autosserviço")
			VAR _eb = [Economia Anual B]
			RETURN SWITCH(_op,
			"Melhorar app, site e URA", "“Problema com aplicativo”: " & FORMAT(_app, "#,0") & " chamados (" & FORMAT(_appp, "0.0") & "%).",
			"Capacitar o Nível 2", "Resolução no Nível 2: " & FORMAT(_r1 - _r0, "+0.0;-0.0") & " p.p. entre " & _l0 & " e " & _l1 & ".",
			"Reforçar a escala nos picos", "Maior volume: " & LOWER(MAXX(_pk, demanda_dia_hora[nome_dia])) & ", " & MAXX(_pk, demanda_dia_hora[hora_abertura]) & "h, com " & FORMAT(MAXX(_pk, [c]), "#,0") & " chamados e taxa de chamados sem início de atendimento (proxy de abandono) de " & FORMAT(MAXX(_pk, [a]), "0.0") & "%.",
			"Reduzir reincidência", "Cenário B: " & IF(_eb >= 1000000, "R$ " & FORMAT(_eb / 1000000, "0.00") & " mi", IF(_eb >= 10000, "R$ " & FORMAT(_eb / 1000, "0.0") & " mil", "R$ " & FORMAT(_eb, "#,0"))) & " por ano com " & FORMAT([Premissa B Valor] * 100, "0") & "% menos reincidência.",
			"Apoiar quem não usa o chatbot", "Chegam ao humano: " & FORMAT(_ho, "0") & "% entre 65+ e " & FORMAT(_hy, "0") & "% entre 25-34 (associação com idade).",
			BLANK())
		displayFolder: Oportunidades
		lineageTag: 3465de66-8f00-5913-aeb5-2dd5a869ff9f

	measure 'Sub Economia A' = FORMAT([Chamados Evitados A], "#,0") & " chamados evitados no período · premissa " & FORMAT([Premissa A Valor], "0%")
		isHidden
