	measure 'Alerta 4 Texto' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([Custo Total], DimMes[Data] = _ini)
			VAR _b = CALCULATE([Custo Total], DimMes[Data] = _fim)
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			VAR _ci = _a
			VAR _cf = _b
			VAR _vi = CALCULATE([Chamados], DimMes[Data] = _ini)
			VAR _vf = CALCULATE([Chamados], DimMes[Data] = _fim)
			VAR _cu = DIVIDE(_cf - _ci, ABS(_ci)) * 100
			VAR _vo = DIVIDE(_vf - _vi, ABS(_vi)) * 100
			RETURN IF(_ini = _fim || ISBLANK(_cu) || ISBLANK(_vo), BLANK(), "O custo mensal variou " & FORMAT(_cu, "+0.0;-0.0") & "% e o volume " & FORMAT(_vo, "+0.0;-0.0") & "% entre " & _ri & " e " & _rf & ".")
		isHidden
		displayFolder: Alertas
		lineageTag: 7909088c-70c9-5924-8ae1-dd333a6ac48e

	measure 'Alerta 4 Nível' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([Custo Total], DimMes[Data] = _ini)
			VAR _b = CALCULATE([Custo Total], DimMes[Data] = _fim)
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			VAR _vi = CALCULATE([Chamados], DimMes[Data] = _ini)
			VAR _vf = CALCULATE([Chamados], DimMes[Data] = _fim)
			VAR _cu = DIVIDE(_b - _a, ABS(_a)) * 100
			VAR _vo = DIVIDE(_vf - _vi, ABS(_vi)) * 100
			RETURN IF(_cu > _vo + 5, 1, 2)
		formatString: 0
		isHidden
		displayFolder: Alertas
		lineageTag: 0df7b8da-3fa3-5fbf-9351-6e155b049fc6

	measure 'Alerta 5 Texto' =
			VAR _k = CALCULATE([Pct Custo Funil], funil_atendimento[etapa_funil] = "Nível 2")
			VAR _c = CALCULATE([Pct Chamados Funil], funil_atendimento[etapa_funil] = "Nível 2")
