			VAR _t = FILTER(comparativo_yoy, comparativo_yoy[chamados_2026] > 0 && NOT ISBLANK(comparativo_yoy[csat_pct_2026]) && NOT ISBLANK(comparativo_yoy[csat_pct_2025]))
			RETURN DIVIDE(SUMX(_t, (comparativo_yoy[csat_pct_2026] - comparativo_yoy[csat_pct_2025]) * comparativo_yoy[chamados_2026]), SUMX(_t, comparativo_yoy[chamados_2026]))
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		displayFolder: Marketing
		lineageTag: 22f8fbee-ee7c-515b-b926-72fb157236c6

	measure 'CSAT YoY Média' =
			VAR _t = FILTER(comparativo_yoy, comparativo_yoy[chamados_2026] > 0 && NOT ISBLANK(comparativo_yoy[csat_pct_2026]) && NOT ISBLANK(comparativo_yoy[csat_pct_2025]))
			RETURN AVERAGEX(_t, comparativo_yoy[csat_pct_2026] - comparativo_yoy[csat_pct_2025])
		formatString: +0.0" p.p.";-0.0" p.p.";0.0" p.p."
		isHidden
		displayFolder: Marketing
		lineageTag: b0f2d57e-19e9-5b86-995b-c5cf33873962

