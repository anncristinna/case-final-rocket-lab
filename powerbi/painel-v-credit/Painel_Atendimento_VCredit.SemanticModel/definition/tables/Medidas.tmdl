	measure 'Delta Chamados' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _ant = EDATE(_fim, -1)
			VAR _a = CALCULATE([Chamados], DimMes[Data] = _ant)
			VAR _b = CALCULATE([Chamados], DimMes[Data] = _fim)
			RETURN IF(_ant < _ini || ISBLANK(_a) || ISBLANK(_b), BLANK(), DIVIDE(_b - _a, ABS(_a)) * 100)
		formatString: 0.00
		isHidden
		displayFolder: Deltas
		lineageTag: 0f9a3f39-a41e-54bd-91bb-63eb744a6799

	measure 'Delta Chamados Texto' =
			VAR _d = [Delta Chamados]
			VAR _ref = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = EDATE(MAX(DimMes[Data]), -1))
			RETURN IF(ISBLANK(_d), "Sem mês anterior no período", IF(ABS(_d) < 0.05, "● estável", IF(_d > 0, "▲ +", "▼ −") & FORMAT(ABS(_d), "0.0") & "%") & " · vs " & _ref)
		displayFolder: Deltas
		lineageTag: ee0df645-dd15-5abd-b03a-26981e467fc8

	measure 'Delta Chamados Cor' =
			VAR _d = [Delta Chamados]
			RETURN IF(ISBLANK(_d) || ABS(_d) < 0.05, "#5f7f84", "#5f7f84")
		isHidden
		displayFolder: Deltas
		lineageTag: 9a91a24c-0093-536e-8863-2acb729af481

