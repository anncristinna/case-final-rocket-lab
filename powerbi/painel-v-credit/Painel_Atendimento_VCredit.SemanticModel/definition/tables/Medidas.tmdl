	measure 'Título Funil Exec' =
			VAR _c = CALCULATE([Pct Chamados Funil], funil_atendimento[etapa_funil] = "Nível 2")
			VAR _k = CALCULATE([Pct Custo Funil], funil_atendimento[etapa_funil] = "Nível 2")
			RETURN "O Nível 2 recebe " & FORMAT(_c, "0.0") & "% dos chamados e responde por " & FORMAT(_k, "0.0") & "% do custo"
		displayFolder: Títulos
		lineageTag: d5ec19be-ff1a-5ce8-80d1-291b364c525b

	measure 'Título Canal Custo' =
			VAR _n2 = DIVIDE(CALCULATE(SUM(funil_atendimento[custo_total]), funil_atendimento[etapa_funil] = "Nível 2"), CALCULATE(SUM(funil_atendimento[chamados]), funil_atendimento[etapa_funil] = "Nível 2"))
			VAR _as = DIVIDE(CALCULATE(SUM(funil_atendimento[custo_total]), funil_atendimento[etapa_funil] = "Autosserviço"), CALCULATE(SUM(funil_atendimento[chamados]), funil_atendimento[etapa_funil] = "Autosserviço"))
			RETURN "Um chamado no Nível 2 custa " & FORMAT(DIVIDE(_n2, _as), "0.0") & " vezes o de um chamado no autosserviço"
		displayFolder: Títulos
		lineageTag: 86d5b750-8ce8-5ce3-8667-d20008169119

	measure 'Título Pareto Custo' =
			VAR _t = ADDCOLUMNS(VALUES(motivos_pareto[motivo]), "cT", CALCULATE(SUM(motivos_pareto[custo_total])))
			VAR _tot = SUMX(_t, [cT])
			VAR _r = ADDCOLUMNS(_t, "cAc", VAR _x = [cT] RETURN SUMX(FILTER(_t, [cT] >= _x), [cT]))
			VAR _need = FILTER(_r, [cAc] - [cT] < 0.8 * _tot)
			VAR _k = COUNTROWS(_need)
			VAR _p = DIVIDE(MAXX(_need, [cAc]), _tot) * 100
			RETURN "Os " & _k & " motivos mais caros somam " & FORMAT(_p, "0") & "% do custo"
		displayFolder: Títulos
		lineageTag: 150e0363-51d7-5088-bcf2-a39aab8fe0d9

	measure 'Título Heatmap' =
			VAR _m = SELECTEDVALUE('Metrica Heatmap'[Metrica], "Volume")
			VAR _t = ADDCOLUMNS(SUMMARIZE(demanda_dia_hora, demanda_dia_hora[nome_dia], demanda_dia_hora[hora_abertura]), "v", [Valor Heatmap])
			VAR _top = TOPN(1, _t, [v], DESC)
			VAR _dia = MAXX(_top, demanda_dia_hora[nome_dia])
			VAR _h = MAXX(_top, demanda_dia_hora[hora_abertura])
			VAR _v = MAXX(_top, [v])
			VAR _fv = SWITCH(_m, "Volume", FORMAT(_v, "#,0") & " chamados", "Sem início (proxy)", FORMAT(_v, "0.0") & "%", FORMAT(_v, "0.0") & " min")
			RETURN "O pico de " & IF(_m = "Sem início (proxy)", "chamados sem início de atendimento (proxy de abandono)", LOWER(_m)) & " ocorre " & LOWER(_dia) & ", às " & _h & "h (" & _fv & ")"
		displayFolder: Títulos
		lineageTag: e1ba55c4-571d-5e67-8fda-3d5b43fb84d1

	measure 'Título Reincidência' =
			VAR _t = ADDCOLUMNS(VALUES(motivos_pareto[motivo_rotulo]), "r", [Reincidência Motivo])
			VAR _top = TOPN(1, _t, [r], DESC)
			RETURN MAXX(_top, motivos_pareto[motivo_rotulo]) & " tem a maior reincidência: " & FORMAT(MAXX(_top, [r]), "0.0") & "% voltam em até 7 dias"
		displayFolder: Títulos
		lineageTag: 6c064ef8-d7ad-5eaa-8720-6b1c4a630b89

