	measure 'Título Idade' =
			VAR _ho = CALCULATE(SUM(perfil_cliente[pct_da_dimensao]), perfil_cliente[dimensao] = "faixa_etaria", perfil_cliente[valor] = "65+", perfil_cliente[etapa_funil] <> "Autosserviço")
			VAR _hy = CALCULATE(SUM(perfil_cliente[pct_da_dimensao]), perfil_cliente[dimensao] = "faixa_etaria", perfil_cliente[valor] = "25-34", perfil_cliente[etapa_funil] <> "Autosserviço")
			RETURN "Entre 65+, " & FORMAT(_ho, "0") & "% dos chamados chegam ao humano; entre 25-34, " & FORMAT(_hy, "0") & "%"
		displayFolder: Títulos
		lineageTag: f879a84d-30f5-5f4b-87c0-6c57ed8c1b8f

	measure 'Título Região' =
			VAR _t = ADDCOLUMNS(CALCULATETABLE(VALUES(perfil_cliente[valor_rotulo]), perfil_cliente[dimensao] = "regiao"), "h", CALCULATE(SUM(perfil_cliente[pct_da_dimensao]), perfil_cliente[etapa_funil] <> "Autosserviço"))
			VAR _hi = TOPN(1, _t, [h], DESC)
			VAR _lo = TOPN(1, _t, [h], ASC)
			RETURN IF(MAXX(_hi, [h]) - MAXX(_lo, [h]) < 1, "Não há diferença relevante entre as regiões no percentual de chamados que chegam ao humano (de " & FORMAT(MAXX(_lo, [h]), "0.0") & "% a " & FORMAT(MAXX(_hi, [h]), "0.0") & "%)", "A região " & MAXX(_hi, perfil_cliente[valor_rotulo]) & " tem o maior percentual no humano (" & FORMAT(MAXX(_hi, [h]), "0") & "%); " & MAXX(_lo, perfil_cliente[valor_rotulo]) & ", o menor (" & FORMAT(MAXX(_lo, [h]), "0") & "%)")
		displayFolder: Títulos
		lineageTag: e21b62e9-d6ad-50fd-a62a-98e45cd87bea

	measure 'Título Qualidade' =
			VAR _n = COUNTX(VALUES(qualidade_dados[indicador_rotulo]), [Pct Dados])
			RETURN IF(_n > 0, _n & " indicadores de qualidade afetam mais de " & [Limite Qualidade] & "% dos chamados", "Nenhum indicador de qualidade passa de " & [Limite Qualidade] & "% dos chamados")
		displayFolder: Títulos
		lineageTag: fff5f18f-90de-509e-996a-672bad0990cc

	measure 'Título Impacto' =
			VAR _a = CALCULATE(MAX(impacto_indicadores[valor_a]), impacto_indicadores[indicador] = "TME (min)", LEFT(impacto_indicadores[metodo_a], 5) = "bruto")
			VAR _b = CALCULATE(MAX(impacto_indicadores[valor_b]), impacto_indicadores[indicador] = "TME (min)", LEFT(impacto_indicadores[metodo_a], 5) = "bruto")
			RETURN "Tratar os tempos muda o TME de " & FORMAT(_a, "0.0") & " para " & FORMAT(_b, "0.0") & " min"
		displayFolder: Títulos
		lineageTag: 39f1f518-b9bc-5384-b438-ffb8707fdadc

	measure 'Título YoY' =
			VAR _d = [CSAT YoY pp]
			RETURN IF(ISBLANK(_d), "CSAT de 2026 contra 2025, mês a mês", "Mês a mês, o CSAT de 2026 está " & FORMAT(ABS(_d), "0.0") & " p.p. " & IF(_d < 0, "abaixo", "acima") & " do de 2025")
		displayFolder: Títulos
		lineageTag: 30df8f1c-d1d8-52d0-bbc0-246b19417f47

	measure 'Título Cobertura' = RETURN "A pesquisa é respondida em " & FORMAT([Cobertura Pesquisa], "0") & "% dos chamados"
		displayFolder: Títulos
		lineageTag: bbb26a7f-5a33-55bf-b5fb-cdf5e9161c2f

	measure 'Título Ajuste' =
			VAR _d = AVERAGEX(FILTER(kpi_mensal, NOT ISBLANK(kpi_mensal[csat_pct]) && NOT ISBLANK(kpi_mensal[csat_ajustado_pct])), kpi_mensal[csat_ajustado_pct] - kpi_mensal[csat_pct])
			RETURN "Recuperar notas inválidas mudaria o CSAT em " & IF(_d >= 0, "+", "−") & FORMAT(ABS(_d), "0.0") & " p.p. em média"
		displayFolder: Títulos
		lineageTag: 8b050f5f-4c99-5fc3-91fc-3d3ee4b34c69

	measure 'Título Drivers' =
			VAR _a = CALCULATE(MAX(satisfacao_drivers[csat_pct]), satisfacao_drivers[dimensao] = "faixa_espera", satisfacao_drivers[valor] = "1) até 5 min")
			VAR _b = CALCULATE(MAX(satisfacao_drivers[csat_pct]), satisfacao_drivers[dimensao] = "faixa_espera", satisfacao_drivers[valor] = "5) mais de 60 min")
			RETURN "A avaliação vai de " & FORMAT(_a, "0") & "% (até 5 min) a " & FORMAT(_b, "0") & "% (mais de 60 min) conforme a espera cresce"
		displayFolder: Títulos
		lineageTag: 76d15366-f423-51c7-91ab-b41c8086cc24

	measure 'Título Ranking Oportunidades' =
			VAR _t = ADDCOLUMNS(VALUES(simulacao_ganhos[iniciativa]), "a", [Economia Anualizada])
			VAR _top = TOPN(1, _t, [a], DESC)
			VAR _v = MAXX(_top, [a])
			RETURN MAXX(_top, simulacao_ganhos[iniciativa]) & " é a iniciativa de maior ganho: " & IF(_v >= 1000000, "R$ " & FORMAT(_v / 1000000, "0.00") & " mi", IF(_v >= 10000, "R$ " & FORMAT(_v / 1000, "0.0") & " mil", "R$ " & FORMAT(_v, "#,0"))) & " por ano"
		displayFolder: Títulos
		lineageTag: 74d3d4e5-67d8-50f2-9901-6af3a62fdc73

	measure 'Título Critério Prioridade' = "Critério: economia anualizada = chamados base × premissa × ganho unitário ÷ meses × 12. Esforço e prazo não estão nos dados."
		isHidden
		displayFolder: Títulos
		lineageTag: 04476196-c020-5c85-9e9f-403c34d23b1c

	measure 'Alerta 1 Delta' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([CSAT], DimMes[Data] = _ini)
			VAR _b = CALCULATE([CSAT], DimMes[Data] = _fim)
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			RETURN IF(_ini = _fim || ISBLANK(_a) || ISBLANK(_b), BLANK(), _b - _a)
		formatString: 0.00
		isHidden
		displayFolder: Alertas
		lineageTag: cb4c90ad-28b3-50fd-9443-c95121223500

	measure 'Alerta 1 Texto' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([CSAT], DimMes[Data] = _ini)
			VAR _b = CALCULATE([CSAT], DimMes[Data] = _fim)
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			VAR _d = [Alerta 1 Delta]
			RETURN IF(ISBLANK(_d), BLANK(), "O CSAT " & IF(_d >= 0, "subiu ", "caiu ") & FORMAT(ABS(_d), "0.0") & " p.p. entre " & _ri & " e " & _rf & " (" & FORMAT(_a, "0.0") & "% → " & FORMAT(_b, "0.0") & "%).")
		isHidden
		displayFolder: Alertas
		lineageTag: 1720cd0e-bbfb-5949-9291-a7f6227c2ce8

	measure 'Alerta 1 Nível' =
			VAR _d = [Alerta 1 Delta]
			RETURN IF(_d <= -2, 0, IF(_d < 0, 1, 3))
		formatString: 0
		isHidden
		displayFolder: Alertas
		lineageTag: df8366b5-f692-542c-9e08-40bdcc824d7c

	measure 'Alerta 2 Delta' =
			VAR _ini = MIN(DimMes[Data])
			VAR _fim = MAX(DimMes[Data])
			VAR _a = CALCULATE([Resolução Etapa], DimMes[Data] = _ini, DimEtapa[Etapa] = "Nível 2")
			VAR _b = CALCULATE([Resolução Etapa], DimMes[Data] = _fim, DimEtapa[Etapa] = "Nível 2")
			VAR _ri = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _ini)
			VAR _rf = CALCULATE(MAX(DimMes[Rotulo]), ALL(DimMes), DimMes[Data] = _fim)
			RETURN IF(_ini = _fim || ISBLANK(_a) || ISBLANK(_b), BLANK(), _b - _a)
		formatString: 0.00
		isHidden
		displayFolder: Alertas
