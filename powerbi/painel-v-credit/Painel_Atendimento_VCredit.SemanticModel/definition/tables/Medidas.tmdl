	measure 'Sub Economia B' = FORMAT([Chamados Evitados B], "#,0") & " chamados evitados no período · premissa " & FORMAT([Premissa B Valor], "0%")
		isHidden
		displayFolder: Oportunidades
		lineageTag: ca19fb1b-ba1b-5c78-91f5-9993415aa994

	measure 'Sub Chatbot' = "URA: " & FORMAT([Resolução URA], "0.0") & "%"
		isHidden
		displayFolder: Tecnologia
		lineageTag: e354ee9c-45dd-5c55-be16-d0be9f391ab2

	column Coluna
		dataType: int64
		isHidden
		lineageTag: 0aa77061-b711-53fe-9434-25c99a36334d
		summarizeBy: none
		sourceColumn: [Coluna]

		annotation SummarizationSetBy = User

	partition Medidas = calculated
