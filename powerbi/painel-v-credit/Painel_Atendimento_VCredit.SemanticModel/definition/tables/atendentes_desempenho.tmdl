	partition atendentes_desempenho = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\atendentes_desempenho.csv"), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"id_atendente", Int64.Type}, {"rotulo_atendente", type text}, {"nivel_atendimento", Int64.Type}, {"data_admissao", type date}, {"data_desligamento", type date}, {"chamados", Int64.Type}, {"atendimentos_validos", Int64.Type}, {"tma_min", type number}, {"p90_tma_min", type number}, {"pct_resolucao", type number}, {"csat_pct", type number}, {"custo_medio", type number}, {"primeiro_chamado", type date}, {"ultimo_chamado", type date}, {"chamados_fora_vigencia", Int64.Type}, {"amostra_suficiente", type logical}, {"tempo_casa_meses_no_ultimo_chamado", type number}, {"pct_resolucao_vs_media_nivel", type number}, {"tma_vs_media_nivel", type number}, {"rank_resolucao_no_nivel", Int64.Type}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "nivel_rotulo", each "Nível " & Text.From([nivel_atendimento]), type text),
					Extra2 = Table.AddColumn(Extra1, "amostra_rotulo", each if [amostra_suficiente] = true then "suficiente" else "pequena", type text)
				in
					Extra2

	annotation PBI_ResultType = Table

