	partition perfil_cliente = m
		mode: import
		source =
				let
					Fonte = Csv.Document(File.Contents(Text.TrimEnd(PastaCSV, "\") & "\perfil_cliente.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"dimensao", type text}, {"valor", type text}, {"etapa_funil", type text}, {"chamados", Int64.Type}, {"pct_da_dimensao", type number}, {"pct_resolucao", type number}, {"pct_abandono", type number}, {"csat_pct", type number}, {"custo_medio", type number}}, "en-US"),
					Extra1 = Table.AddColumn(Tipos, "valor_rotulo", each if [dimensao] = "regiao" then Text.Proper([valor]) else [valor], type text)
				in
					Extra1

	annotation PBI_ResultType = Table

